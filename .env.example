# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Public origin used in copied invite links. Set this to the deployed app URL.
NEXT_PUBLIC_APP_URL=https://75-soft-seven.vercel.app

# Server-only. Never expose or commit this value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign short-lived invite signup intents.
INVITE_INTENT_SECRET=replace-with-a-long-random-secret
